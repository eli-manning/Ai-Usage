{
  "name": "ai-usage",
  "version": "1.0.11",
  "description": "AI coding usage in your system tray",
  "author": "Eli Manning",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev:mac": "electron-builder --mac --dir && open 'dist/mac-arm64/AI Usage.app'",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux",
    "test": "node test/win-pty-driver.test.js"
  },
  "build": {
    "appId": "com.eli.aiusage",
    "productName": "AI Usage",
    "artifactName": "AI-Usage-Setup.${ext}",
    "afterSign": "scripts/afterSignHook.js",
    "files": [
      "**/*",
      "!dev-scratch/**/*",
      "!__pycache__/**/*",
      "!**/*.md",
      "!test/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "pty-wrapper.py",
        "to": "pty-wrapper.py"
      },
      {
        "from": "agy-pty-wrapper.py",
        "to": "agy-pty-wrapper.py"
      },
      {
        "from": "codex-pty-wrapper.py",
        "to": "codex-pty-wrapper.py"
      },
      {
        "from": "cursor-pty-wrapper.py",
        "to": "cursor-pty-wrapper.py"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "nsis": {
      "shortcutName": "AI Usage"
    }
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
